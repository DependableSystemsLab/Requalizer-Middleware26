# Host build output and environments: the image builds and installs its own. obj/ in particular holds
# restore files with absolute host paths, which would break `dotnet build` inside the image.
**/bin/
**/obj/
**/node_modules/
scripts/presentation/.venv/
**/*.log
.git/
# Experiment output the scripts write under data/ (run-all.sh's and run-experiment.sh's defaults, test runs):
# only the original data belongs in the image.
data/demo-results-*/
data/experiment-*/
data/test/
