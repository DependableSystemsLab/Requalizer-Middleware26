<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OneOS.WebTerminal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OneOS\OneOS.csproj" />
  </ItemGroup>

  <!-- The front end (served as static files; the client option serves another copy, e.g. this folder while editing it). -->
  <ItemGroup>
    <None Include="client\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
