<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OneOS</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNext.Net.Cluster" Version="5.3.0" />
    <PackageReference Include="MessagePack" Version="3.1.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Pidgin" Version="3.5.1" />
    <PackageReference Include="Google.OrTools" Version="9.11.4210" />
  </ItemGroup>

  <!-- The JavaScript environment (oneos.js), installed into <mount>/temp/node_modules/oneos (plan step 7). -->
  <ItemGroup>
    <EmbeddedResource Include="Runtime\Driver\JavaScriptEnvironment\*.js" LogicalName="oneos.js/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
